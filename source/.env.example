# Переменные для docker compose. Скопируйте в .env в корне репозитория.
# Учетные данные DeepSeek - в файле api (см. api.example), он монтируется в Backend.

DEBUG=false
LOG_LEVEL=

# Origin браузера для CORS (Frontend в Docker слушает :3000).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Порты на хосте (только loopback).
BACKEND_PORT=8000
FRONTEND_PORT=3000
MYSQL_PORT=3306
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# URL Backend, который видит браузер (не имя сервиса Docker).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
PUBLIC_APP_BASE_URL=http://127.0.0.1:3000

# MySQL для пользователей/сессий (только compose/dev defaults - смените в prod).
MYSQL_ROOT_PASSWORD=dev-root-change-me
MYSQL_DATABASE=java_blueprints_auth
MYSQL_USER=jb_auth
MYSQL_PASSWORD=dev-auth-change-me

AUTH_COOKIE_SECURE=false
# ВРЕМЕННО для разработки: API без обязательного входа; без письма и политики пароля.
AUTH_API_GATE_ENABLED=false
AUTH_DEV_AUTO_VERIFY_EMAIL=true
AUTH_PASSWORD_MIN_LENGTH=1
AUTH_ENFORCE_PASSWORD_COMPLEXITY=false
AUTH_HIBP_ENABLED=false
SMTP_FROM=noreply@java-blueprints.local
# Java-тесты в Docker: макс. 5 мин на контейнер, ограниченная RAM.
JAVA_SUITE_TIMEOUT_SECONDS=300
JAVA_CASE_TIMEOUT_SECONDS=30
JAVA_DOCKER_MEMORY=384m
JAVA_DOCKER_CPUS=1.0
JAVA_DOCKER_IMAGE=eclipse-temurin:21-jdk

# LLM (DeepSeek). Ключ предпочтительно в ./api; LLM_API_KEY перекрывает файл.
LLM_ENABLED=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_VERIFY_SSL=true
LLM_TIMEOUT_SECONDS=180
