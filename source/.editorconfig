root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{ps1,cmd,bat}]
end_of_line = crlf

# Windows PowerShell 5.1 читает файл без BOM как ANSI и искажает кириллицу.
[*.ps1]
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false

[fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
