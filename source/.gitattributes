# Единая нормализация переносов строк для исходников и конфигурации.
* text=auto eol=lf

# Скрипты Windows ожидают CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Java-фикстуры хранятся байт-в-байт: тесты round-trip проверяют точное совпадение, включая CRLF и BOM.
fixtures/** -text

# Бинарные файлы.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.jar binary
*.class binary
*.zip binary
