# Скопируйте в backend/.env. Все значения необязательны: ниже указаны значения по умолчанию.

# true включает подробный DEBUG-лог. Traceback и внутренние детали клиенту не отдаются никогда.
DEBUG=false

# Адрес и порт для `python -m app`. В контейнере используется 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8000

# Точные origin Frontend через запятую, без пути и без "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Локальный SQLite-файл (проекты/ревизии). Относительный путь отсчитывается от backend/.
DATABASE_URL=sqlite:///./var/java_blueprints.sqlite3

# Каталог runtime-данных проектов. Относительный путь отсчитывается от backend/.
STORAGE_DIR=./var/storage

# --- Auth ---
# memory - без MySQL (тесты/локально). mysql - пользователи/сессии в MySQL.
AUTH_STORE=memory
# Пример для compose/prod: mysql://jb_auth:CHANGE_ME@127.0.0.1:3306/java_blueprints_auth
AUTH_MYSQL_DSN=
# ВРЕМЕННО для разработки: false = API без обязательного входа (LLM, схема->код, parse).
AUTH_API_GATE_ENABLED=false
# ВРЕМЕННО для разработки: сразу подтверждать email без письма (без Mailpit).
AUTH_DEV_AUTO_VERIFY_EMAIL=true
AUTH_SESSION_TTL_SECONDS=86400
AUTH_COOKIE_NAME=jb_session
AUTH_CSRF_COOKIE_NAME=jb_csrf
# true для HTTPS; false только для локального http.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
# ВРЕМЕННО: ослабленная политика пароля (вернуть min=12 + complexity/HIBP перед продом).
AUTH_PASSWORD_MIN_LENGTH=1
AUTH_ENFORCE_PASSWORD_COMPLEXITY=false
# Проверка паролей по HIBP (k-anonymity). При сбое сети - fail-open.
AUTH_HIBP_ENABLED=false
AUTH_HIBP_TIMEOUT_SECONDS=3
AUTH_EMAIL_VERIFY_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_LOGIN_RATE_MAX=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_RESET_RATE_MAX=3
AUTH_RESET_RATE_WINDOW_SECONDS=300
PUBLIC_APP_BASE_URL=http://localhost:3000

# SMTP (Mailpit в compose: host mailpit / на хосте 127.0.0.1:1025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@java-blueprints.local
SMTP_USE_TLS=false

# Максимальный размер Java-исходника для Parser в байтах UTF-8 (по умолчанию 4 МиБ).
MAX_JAVA_SOURCE_BYTES=4194304

# --- Изолированный запуск Java после LLM (Docker JDK 21 на хосте Backend) ---
# Один контейнер на вариант кода (original / repaired), TTL и удаление после тестов.
JAVA_DOCKER_IMAGE=eclipse-temurin:21-jdk
JAVA_DOCKER_MEMORY=384m
JAVA_DOCKER_CPUS=1.0
JAVA_DOCKER_PIDS_LIMIT=64
# Максимум 5 минут на контейнер; один stdin-кейс до 30 с.
JAVA_SUITE_TIMEOUT_SECONDS=300
JAVA_CASE_TIMEOUT_SECONDS=30
# Для compose (см. compose.yaml). На хосте с `uv run` оставьте пустым.
JAVA_WORK_DIR=
JAVA_DOCKER_WORK_VOLUME=

# CRITICAL, ERROR, WARNING, INFO, DEBUG. Пусто: DEBUG при DEBUG=true, иначе INFO.
LOG_LEVEL=
LOG_TO_FILE=true
LOG_FILE=./var/logs/java_blueprints.log

# --- LLM (DeepSeek) ---
# Учетные данные: файл api в корне (см. api.example) или LLM_API_KEY=sk-...
LLM_ENABLED=true
LLM_API_KEY=
LLM_API_KEY_FILE=
LLM_BASE_URL=https://api.deepseek.com
LLM_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
LLM_MODEL=deepseek-chat
LLM_SCOPE=GIGACHAT_API_PERS
LLM_VERIFY_SSL=true
LLM_TIMEOUT_SECONDS=180
LLM_INCLUDE_FLOWCHART_ASSIST=false
